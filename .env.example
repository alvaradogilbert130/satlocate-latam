# Puerto del Servidor Backend
PORT=3000
BASE_URL=http://localhost:3000

# Integración dLocal Go (Checkout & Cobros Recurrentes LATAM)
# Si se dejan en blanco, la aplicación entrará automáticamente en modo Sandbox/Demostración.
DLOCAL_API_KEY=your_dlocal_api_key_here
DLOCAL_SECRET_KEY=your_dlocal_secret_key_here

# Integración Twilio (Disparo de SMS Automatizado)
# Si se dejan en blanco, el backend simulará el disparo del SMS e imprimirá el enlace directo en consola/UI.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15005550006

# Integración Mapbox (Renderizado de Mapas en Tiempo Real)
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiZGV2LXNhdGxvY2F0ZSIsImEiOiJjbTAxMm5vM3gwMG5sMmxzYTY3bThhNzRzIn0.sample_token_or_replace_with_yours
